{
  "name": "@xxanderwp/jstoolkit",
  "version": "1.0.0",
  "description": "A Swiss Army knife of useful JavaScript/TypeScript utilities for everyday development",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "utilities",
    "helpers",
    "toolkit",
    "typescript",
    "string",
    "array",
    "math",
    "date",
    "random",
    "format"
  ],
  "author": "xxanderwp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxanderwp/jstoolkit.git"
  },
  "bugs": {
    "url": "https://github.com/xxanderwp/jstoolkit/issues"
  },
  "homepage": "https://github.com/xxanderwp/jstoolkit#readme",
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/jest": "^29.5.12",
    "@types/md5": "^2.3.5",
    "@types/node": "^20.11.19",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rollup": "^4.10.0",
    "rollup-plugin-dts": "^6.1.0",
    "ts-jest": "^29.1.2",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "md5": "^2.3.0"
  }
}